{
  "name": "sme-website-demo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc -b && vite build",
    "build:gh": "tsc -b && vite build --base=/sme-website-demo/ && node scripts/copy-404.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test": "node --disable-warning=ExperimentalWarning --test --test-force-exit \"server/test/**/*.test.ts\"",
    "test:coverage": "node --disable-warning=ExperimentalWarning --experimental-test-coverage --test-coverage-include=server/** --test-coverage-include=shared/** --test --test-force-exit \"server/test/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
